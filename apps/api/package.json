{
  "name": "@greenchain/api",
  "private": true,
  "type": "module",
  "scripts": {
    "demo:local": "node --env-file-if-exists=../../.env --import tsx scripts/local-demo.ts",
    "dev": "node --env-file=../../.env --import tsx src/bootstrap/server.ts",
    "db:migrate": "node --env-file=../../.env --import tsx src/bootstrap/migrate.ts",
    "db:setup": "node --env-file=../../.env --import tsx src/bootstrap/setup.ts",
    "worker": "node --env-file=../../.env --import tsx src/bootstrap/worker.ts",
    "proofs": "node --env-file=../../.env --import tsx src/bootstrap/proofs.ts",
    "audit:verify": "node --env-file=../../.env --import tsx src/bootstrap/audit-verify.ts",
    "contracts:compile": "node scripts/compile-contract.mjs",
    "test": "node --v8-pool-size=1 --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@greenchain/geometry": "0.1.0",
    "ethers": "6.17.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "hardhat": "3.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
