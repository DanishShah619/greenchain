DATABASE_URL=postgres://greenchain:local-demo-only@localhost:5432/greenchain
WEB_ORIGIN=http://localhost:3000
PORT=4000
HOST=127.0.0.1
COOKIE_SECURE=false
# Number of trusted reverse-proxy hops in front of the API (1-5). Leave blank when reached directly.
# Set it when hosted behind a proxy or CDN, otherwise every user shares the proxy address and the login limiter locks everyone out together.
TRUST_PROXY=
# Set a unique password of at least 16 characters before db:setup.
DEMO_PRESENTER_PASSWORD=
DEMO_VERIFIER_PASSWORD=
# Persist the same independently generated 32-byte base64url audit key for API and worker.
AUDIT_HMAC_KEY=
# Optional Polygon Amoy proof service. Leave all four blank to keep proofs queued locally.
AMOY_RPC_URL=
AMOY_CONTRACT_ADDRESS=
AMOY_CONTRACT_CODE_HASH=
AMOY_SIGNER_KEY_FILE=
AMOY_CONFIRMATIONS=12
AMOY_MAX_FEE_GWEI=200
